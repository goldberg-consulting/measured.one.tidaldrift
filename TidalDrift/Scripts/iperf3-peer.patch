+/* Never learn this address from iperf's network parameters: TidalDrift
+ * supplies the established TCP control peer on the server command line. */
+static inline int
+tidaldrift_peer_allowed(const struct iperf_test *test, const struct sockaddr_storage *peer)
+{
+    return !test->tidaldrift_peer || (peer->ss_family == AF_INET &&
+        ((const struct sockaddr_in *)peer)->sin_addr.s_addr == test->tidaldrift_peer);
+}
+
+/* A stray setup packet was consumed. Keep waiting for the intended stream. */
+#define TIDALDRIFT_IGNORE_STREAM (-2)
